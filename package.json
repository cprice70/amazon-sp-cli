{
  "name": "amazon-sp-cli",
  "version": "0.2.0",
  "description": "CLI for Amazon Selling Partner API",
  "keywords": [
    "amazon",
    "selling-partner-api",
    "sp-api",
    "cli",
    "seller",
    "fba",
    "orders",
    "inventory",
    "listings"
  ],
  "homepage": "https://github.com/cprice70/amazon-sp-cli#readme",
  "bugs": {
    "url": "https://github.com/cprice70/amazon-sp-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cprice70/amazon-sp-cli.git"
  },
  "license": "MIT",
  "author": "Chris Price",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "amazon-sp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "watch": "tsc -p tsconfig.build.json --watch",
    "start": "node build/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "amazon-sp-api": "^1.0.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
